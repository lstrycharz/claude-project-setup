#!/usr/bin/env bash
#
# claude-init — Bootstrap a generic non-code Claude harness in the current
# directory. Idempotent: safe to re-run; existing files are preserved.
#
# Usage:
#   cd /path/to/new/project
#   claude-init               # scaffold the harness
#   claude-init --dry-run     # show what would be created without writing
#   claude-init --update      # re-sync rules and skills from the master kit
#                             # (overwrites only files in .claude/references/
#                             # and .claude/skills/ — leaves your notes alone)
#   claude-init --help
#
# What gets created in the project:
#   CLAUDE.md                         (project-root boot sector)
#   inputs/                           (you put source materials here)
#   notes/                            (Claude's working notes and drafts)
#     questions.md
#     findings.md
#     open-threads.md
#   sources/
#     index.md                        (source inventory, maintained by /intake)
#   .claude/
#     settings.json                   (model config: Thinker vs Critic)
#     references/global/              (thinking-rules, source-discipline, critic-prompt)
#     skills/                         (intake, brainstorm, critique, synthesize)
#     .installed-manifest             (records what was installed)
#
# No project types. No PRD/Spec/Workplan templates. This kit is for open-ended
# research, brainstorming, and analysis projects where Claude drafts and a
# separate Critic agent attacks the drafts.

set -euo pipefail

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
SETUP_ROOT="$( dirname "$SCRIPT_DIR" )"
PROJECT_DIR="$( pwd )"

DRY_RUN=false
UPDATE=false
for arg in "$@"; do
  case $arg in
    --dry-run) DRY_RUN=true ;;
    --update)  UPDATE=true ;;
    -h|--help)
      sed -n '2,35p' "$0"
      exit 0
      ;;
    *)
      echo "Unknown argument: $arg" >&2
      echo "Run with --help for usage." >&2
      exit 1
      ;;
  esac
done

if [[ "$PROJECT_DIR" == "$SETUP_ROOT" ]]; then
  echo "ERROR: refusing to scaffold inside the claude-project-setup kit itself." >&2
  echo "Run claude-init from a target project folder, not from the kit's root." >&2
  exit 1
fi

say() { echo "  $*"; }

copy_file() {
  local src="$SETUP_ROOT/$1"
  local dest="$PROJECT_DIR/$2"
  local force="${3:-false}"

  if [[ ! -f "$src" ]]; then
    say "[skip - missing source] $1"
    return
  fi

  if [[ -f "$dest" && "$force" != "true" ]]; then
    say "[skip - exists]         $2"
    return
  fi

  if $DRY_RUN; then
    say "[DRY RUN - would write] $2"
    return
  fi

  mkdir -p "$( dirname "$dest" )"
  cp "$src" "$dest"
  say "[written]               $2"
}

ensure_dir() {
  local d="$PROJECT_DIR/$1"
  if [[ -d "$d" ]]; then
    say "[skip - dir exists]     $1/"
    return
  fi
  if $DRY_RUN; then
    say "[DRY RUN - would mkdir] $1/"
    return
  fi
  mkdir -p "$d"
  say "[mkdir]                 $1/"
}

if $UPDATE; then
  echo "Updating rules and skills in: $PROJECT_DIR"
else
  echo "Scaffolding generic Claude harness in: $PROJECT_DIR"
fi
echo ""

echo "Directories:"
ensure_dir "inputs"
ensure_dir "notes"
ensure_dir "sources"
ensure_dir ".claude/references/global"
ensure_dir ".claude/skills"
echo ""

if ! $UPDATE; then
  echo "Project files (preserved on re-run):"
  copy_file "templates/CLAUDE.md"                  "CLAUDE.md"
  copy_file "templates/questions-starter.md"       "notes/questions.md"
  copy_file "templates/findings-starter.md"        "notes/findings.md"
  copy_file "templates/open-threads-starter.md"    "notes/open-threads.md"
  copy_file "templates/sources-index-starter.md"   "sources/index.md"
  copy_file "templates/settings-starter.json"      ".claude/settings.json"
  echo ""
fi

echo "Rules (overwritten on --update):"
copy_file "references/global/thinking-rules.md"    ".claude/references/global/thinking-rules.md"    "$UPDATE"
copy_file "references/global/source-discipline.md" ".claude/references/global/source-discipline.md" "$UPDATE"
copy_file "references/global/critic-prompt.md"     ".claude/references/global/critic-prompt.md"     "$UPDATE"
echo ""

echo "Skills (overwritten on --update):"
for skill in intake brainstorm critique synthesize; do
  copy_file "skills/$skill/SKILL.md" ".claude/skills/$skill/SKILL.md" "$UPDATE"
done
echo ""

if ! $DRY_RUN; then
  mkdir -p "$PROJECT_DIR/.claude"
  {
    echo "# Installed by claude-init (claude-project-setup, generic harness)"
    echo "installed_at: $( date -u +%Y-%m-%dT%H:%M:%SZ )"
    echo "setup_root: $SETUP_ROOT"
    if $UPDATE; then echo "last_update: $( date -u +%Y-%m-%dT%H:%M:%SZ )"; fi
  } > "$PROJECT_DIR/.claude/.installed-manifest"
fi

echo ""
if $UPDATE; then
  echo "Update complete. Rules and skills re-synced from the master kit."
else
  echo "Scaffold complete. Drop source materials in inputs/, then run /intake."
fi
echo "Re-run safely any time. Use --update to refresh rules and skills."
